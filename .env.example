# ==============================================================================
# DIGEST MEDIA DASHBOARD - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local and replace with your actual service credentials.
# ==============================================================================

# Supabase Client Configuration (Public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Admin / Service Role Key (Private - Server only)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Cloudflare R2 Object Storage (Private - Server only)
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=digest-media-assets

# Cloudflare R2 Public Domain / Custom CDN URL (Public)
NEXT_PUBLIC_CLOUDFLARE_R2_PUBLIC_URL=https://pub-your-bucket-hash.r2.dev
